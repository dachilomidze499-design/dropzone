# Copy to .env.local for local development; never commit populated secrets.
ზ# Required by /api/admin in local, preview, and production environments.
# Use a private PIN (up to 128 characters) and a random session secret of 32+ characters.
ADMIN_PIN=
ADMIN_SESSION_SECRET=

# Required for non-test admin access (including Vercel deployments).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional for general admin access; required for media uploads.
FIREBASE_STORAGE_BUCKET=

# Set to "test" only for isolated local mock data; leave blank on Vercel.
DROPZONE_ADMIN_MODE=
