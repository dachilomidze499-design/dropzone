# Copy to .env.local for local development; never commit populated secrets.
ADMIN_PIN=
ADMIN_SESSION_SECRET=

# Required only for real Firestore/Storage data and production PIN login.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Set to "test" only for the isolated local mock-data mode; leave blank on Vercel.
DROPZONE_ADMIN_MODE=
